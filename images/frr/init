#!/usr/bin/env bash
set -euo pipefail

SOCK=/var/run/frr/reload.sock
FRR_CONF=/etc/frr/frr.conf
FRR_WATCH=/usr/lib/frr/watchfrr
FRR_INIT=/usr/lib/frr/frrinit.sh
PROBE_PORT="${PROBE_PORT:-24801}"
STOP=0
SOCAT_PID=

postmortem() {
  printf '[postmortem] curl -i http://localhost:%s/livez\n' "$PROBE_PORT"
  curl -sS -i "http://localhost:${PROBE_PORT}/livez" || true

  printf '[postmortem] bridge fdb\n'
  bridge fdb || true

  printf '[postmortem] vtysh -c "show bgp l2vpn evpn route"\n'
  vtysh -c "show bgp l2vpn evpn route" || true
}

cleanup() {
  postmortem || true

  STOP=1
  if [[ -S "$SOCK" || -e "$SOCK" ]]; then
    rm -f "$SOCK"
  fi
  if [[ -n "${SOCAT_PID}" ]]; then
    kill "$SOCAT_PID" 2>/dev/null || true
  fi
  "$FRR_INIT" stop || true
  exit 0
}

trap cleanup TERM INT

rm -f "$SOCK"
$FRR_WATCH \
    -i 5 \
    -t 20 \
    --min-restart-interval 5 \
    --max-restart-interval 20 \
    zebra staticd bgpd &

python3 probe &

while [[ "$STOP" -eq 0 ]]; do
  socat -u "UNIX-LISTEN:$SOCK,fork,unlink-close" EXEC:/handle-command &
  SOCAT_PID=$!
  wait "$SOCAT_PID" || true
done
